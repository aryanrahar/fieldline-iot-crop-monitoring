# Core server configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Browser origins allowed to call the API when the frontend is hosted separately.
# Same-origin production deployments can leave this empty.
CORS_ORIGINS=http://localhost:5173

# Set a long random value in production. Devices/simulators send it as X-Device-Key.
# Leave blank only for local development if you intentionally want unauthenticated ingestion.
DEVICE_API_KEY=

# Optional local JSONL persistence. On ephemeral hosting, persisted files may be reset after restart or redeployment.
# demo, DEMO_MODE is sufficient. Docker Compose mounts this path to a named volume.
DATA_FILE=./data/readings.jsonl
STORE_CAPACITY=5000
MAX_BODY_BYTES=65536

# Abuse protection
INGEST_RATE_LIMIT_PER_MINUTE=180
READ_RATE_LIMIT_PER_MINUTE=1200

# Demo mode: seeds sample telemetry history and emits a new sample periodically.
DEMO_MODE=false
DEMO_INTERVAL_MS=5000

# Background third-party integration worker
INTEGRATION_RETRIES=2
INTEGRATION_QUEUE_SIZE=500

# Optional external integrations. Never commit real values.
FIREBASE_DATABASE_URL=
FIREBASE_AUTH_TOKEN=
BLYNK_SERVER=https://blynk.cloud
BLYNK_AUTH_TOKEN=

# Frontend only. Leave empty for same-origin production deployment.
VITE_API_URL=http://localhost:8080

