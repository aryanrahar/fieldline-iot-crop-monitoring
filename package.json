{
  "name": "fieldline-crop-monitoring",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node backend/server.mjs",
    "api": "node backend/server.mjs",
    "simulate": "node simulator/sensor-simulator.mjs",
